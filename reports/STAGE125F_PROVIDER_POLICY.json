        "_ZdaPv"
      ]
    },
    "libz.so": {
      "mode": "partial_guest_provider",
      "provider": "guest zlib provider",
      "provided_symbols": [
        "inflate",
        "inflateEnd",
        "inflateInit2_",
        "inflateInit_"
      ]
    },
    "libdl.so": {
